# FaceMark configuration. Copy to .env and fill in.
#
#     cp .env.example .env
#
# .env is gitignored. A real environment variable always beats a value here, so
# production can set these through the platform and ignore this file entirely.


# --- Database (required) -----------------------------------------------------
# PostgreSQL only. There is no SQLite fallback: one that engaged silently when
# this was unset would let a deployment come up writing to a container-local
# file that disappears on the next deploy.
#
#   local install     postgresql://postgres:PASSWORD@localhost:5432/facemark
#   Neon / Supabase   postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
#
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/facemark

# Connection pool bounds. The dashboard issues eight small counts per load, so
# the floor matters more than the ceiling on a small instance.
DB_POOL_MIN=1
DB_POOL_MAX=10


# --- Photo storage -----------------------------------------------------------
# local -> photos under data/, where they have always lived. Nothing else needed.
# s3    -> photos in an S3-compatible bucket. Everything below becomes required.
FACEMARK_STORAGE=local

# S3_ENDPOINT_URL is what makes this work with Cloudflare R2 and MinIO as well
# as AWS. Leave it empty for AWS S3.
#   R2:  https://<account-id>.r2.cloudflarestorage.com   (and S3_REGION=auto)
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional key prefix, so one bucket can serve several environments.
S3_PREFIX=


# --- First run ---------------------------------------------------------------
# Sets the initial super-admin password instead of generating one. Only read
# when the users table is empty; change it from inside the app afterwards.
FACEMARK_ADMIN_PASSWORD=


# --- Browser-facing ----------------------------------------------------------
# Origins allowed to call the API directly, comma-separated. A wildcard is NOT
# valid here: session auth rides a credentialed cookie, and browsers reject
# "*" alongside credentials.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Set both to 1 / none only for genuine cross-site use (a frontend on a
# different domain from the API). Setting CORS_ORIGINS without these produces a
# login that appears to succeed and then 401s on every following request.
COOKIE_SECURE=0
COOKIE_SAMESITE=lax
