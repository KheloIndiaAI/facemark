# FaceMark configuration. Copy to .env and fill in.
#
#     cp .env.example .env
#
# .env is gitignored. A real environment variable always beats a value here, so
# production can set these through the platform and ignore this file entirely.


# --- Database (required) -----------------------------------------------------
# PostgreSQL only. There is no SQLite fallback: one that engaged silently when
# this was unset would let a deployment come up writing to a container-local
# file that disappears on the next deploy.
#
#   local install     postgresql://postgres:PASSWORD@localhost:5432/facemark
#   Neon / Supabase   postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
#
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/facemark

# Connection pool bounds. The dashboard issues eight small counts per load, so
# the floor matters more than the ceiling on a small instance.
DB_POOL_MIN=1
DB_POOL_MAX=10


# --- Photo storage -----------------------------------------------------------
# local -> photos under data/, where they have always lived. Nothing else needed.
# s3    -> photos in an S3-compatible bucket. Everything below becomes required.
FACEMARK_STORAGE=local

# S3_ENDPOINT_URL is what makes this work with Cloudflare R2 and MinIO as well
# as AWS. Leave it empty for AWS S3.
#   R2:  https://<account-id>.r2.cloudflarestorage.com   (and S3_REGION=auto)
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional key prefix, so one bucket can serve several environments.
S3_PREFIX=


# --- Timezone ----------------------------------------------------------------
# The timezone the CENTRE is in. This decides what "today" means for
# attendance, the dashboard and the export - NOT the server's own clock.
#
# It matters because EC2 and most containers run UTC, and IST is UTC+5:30: a
# 5:00 AM session is 23:30 UTC the previous day, so morning training would be
# filed under yesterday and today's register would look empty.
FACEMARK_TIMEZONE=Asia/Kolkata


# --- First run ---------------------------------------------------------------
# Sets the initial super-admin password instead of generating one. Only read
# when the users table is empty; change it from inside the app afterwards.
FACEMARK_ADMIN_PASSWORD=


# --- Browser-facing ----------------------------------------------------------
# Origins allowed to call the API directly, comma-separated. A wildcard is NOT
# valid here: session auth rides a credentialed cookie, and browsers reject
# "*" alongside credentials.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Set both to 1 / none only for genuine cross-site use (a frontend on a
# different domain from the API). Setting CORS_ORIGINS without these produces a
# login that appears to succeed and then 401s on every following request.
COOKIE_SECURE=0
COOKIE_SAMESITE=lax

# --- Behind a proxy ----------------------------------------------------------
# How many reverse proxies sit in front of this application. X-Forwarded-For is
# written by the client and APPENDED to by each proxy, so only the last N
# entries were added by infrastructure. 0 means "no proxy": ignore the header
# and use the socket address, which is never forgeable. Caddy or a single ALB
# in front means 1. Setting this HIGHER than reality lets any caller choose
# their own login/signup throttle bucket, so the default is the cautious end.
TRUSTED_PROXY_HOPS=0

# --- Paths and process -------------------------------------------------------
# Where writable data lives. On a platform that replaces the container each
# deploy this MUST point at a mounted disk or the database, the enrolled
# templates and every photograph are lost on the next push.
FACEMARK_DATA_DIR=
# Models are configured separately and deliberately: in the container they are
# baked into the image, while FACEMARK_DATA_DIR points at a volume. Folding
# them together would silently relocate the models to an empty disk.
FACEMARK_MODELS_DIR=
HOST=127.0.0.1
PORT=8000

# --- Retention ---------------------------------------------------------------
# Days before an undecided or refused registration is forgotten - the person,
# their templates, their photographs and their account together. See
# DATA-HANDLING.md.
FACEMARK_PENDING_TTL_DAYS=30
FACEMARK_REJECTED_TTL_DAYS=30

# --- Recognition tuning ------------------------------------------------------
# Leave these alone unless you have re-measured. Every default in
# backend/config.py carries the measurement that justifies it, and these
# override them at runtime with no such record.
DETECTION_MODE=fused
# 1:1 bars for signing a register (coach) and self-marking (athlete).
COACH_VERIFY_THRESHOLD=
SELF_VERIFY_THRESHOLD=
# How many failed face checks before a register is submitted unverified and
# flagged for an administrator, rather than blocking the coach entirely.
VERIFY_MAX_RETRIES=
# Degrees of pitch tolerated in the enrolment framing guide.
FACEMARK_MAX_PORTRAIT_PITCH=
