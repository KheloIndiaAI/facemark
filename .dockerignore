# Keep the build context small - it is uploaded to the builder in full.
.venv/
venv/
__pycache__/
**/__pycache__/
*.pyc

# Models are downloaded inside the build, never copied from the host.
data/models/

# Same for the browser-side MediaPipe runtime and face model. A developer who
# has run scripts/fetch_frontend_models.py locally has 27 MB sitting here, and
# without this line every build would upload it to the builder only for the
# fetch step to produce the same bytes again.
frontend/vendor/

# Runtime data belongs on the mounted disk.
data/uploads/
data/students/
data/temp_crops/
data/*.db
data/*.db.bak

.backup_baseline/
.backup_pre_removal/
samples/
.git/
.github/
.vercel/
node_modules/
*.md
!README.md
.env
.env.*
